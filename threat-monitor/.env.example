# Дозор — пример конфигурации. Скопируйте в .env и заполните нужное.
# Файл .env не добавляйте в репозиторий.

# --- Сервер ---
DOZOR_HOST=127.0.0.1
DOZOR_PORT=8080
# DOZOR_DB_PATH=var/dozor.sqlite3
# DOZOR_SECRET=            # если пусто, генерируется и хранится рядом с БД
DOZOR_SESSION_HOURS=8
DOZOR_COOKIE_SECURE=0      # 1 — при работе за HTTPS
DOZOR_MAX_REQUESTS_PER_CONNECTOR=12
DOZOR_MAX_ITEMS_PER_SEARCH=500
DOZOR_EXCERPT_CHARS=700
DOZOR_CONTEXT_CHARS=500

# --- Списки наблюдения (публичные источники, через запятую) ---
DOZOR_TELEGRAM_CHANNELS=
DOZOR_VK_DOMAINS=
DOZOR_RSS_FEEDS=
DOZOR_MASTODON_INSTANCES=
DOZOR_TWITCH_CHANNELS=
DOZOR_TWITCH_CHAT_CAPTURE_SECONDS=0
DOZOR_DISCORD_CHANNEL_IDS=

# --- Ключи официальных API ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# TELEGRAM_SESSION=var/telegram.session
VK_ACCESS_TOKEN=
YOUTUBE_API_KEY=
THREADS_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
X_BEARER_TOKEN=
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# --- Необязательные модели ---
# DOZOR_GLOTLID_MODEL=/path/to/glotlid/model.bin   # требует pip install fasttext
# DOZOR_LEXICON_EXTRA=/path/to/lexicon-extra.json  # дополнения лексикона

# --- Второй классификатор (LLM). По умолчанию выключен: это передача данных во внешний сервис ---
DOZOR_LLM_ENABLED=0
DOZOR_LLM_MODEL=claude-opus-5-5
DOZOR_LLM_EFFORT=medium
# ANTHROPIC_API_KEY=
